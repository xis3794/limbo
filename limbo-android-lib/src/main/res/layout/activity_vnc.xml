<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <com.max2idea.android.limbo.vnc.VncView
        android:id="@+id/vnc_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/vnc_top"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="12dp">

        <ImageButton
            android:id="@+id/vnc_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vnc_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vnc_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/vnc_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_sdl_pill"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/vnc_keyboard"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vnc_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_sdl_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/vnc_esc"
            style="@style/VncKey"
            android:text="Esc" />

        <TextView
            android:id="@+id/vnc_tab"
            style="@style/VncKey"
            android:text="Tab" />

        <TextView
            android:id="@+id/vnc_cad"
            style="@style/VncKey"
            android:text="Ctrl+Alt+Del" />

        <TextView
            android:id="@+id/vnc_arrows"
            style="@style/VncKey"
            android:text="↑↓←→" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vnc_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/vnc_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vnc_retry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_primary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:stateListAnimator="@null"
                android:text="@string/vnc_retry"
                android:textAllCaps="false"
                android:textColor="@color/limbo_on_accent"
                android:textSize="14sp" />

            <Button
                android:id="@+id/vnc_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:stateListAnimator="@null"
                android:text="@string/vnc_close"
                android:textAllCaps="false"
                android:textColor="@color/limbo_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
