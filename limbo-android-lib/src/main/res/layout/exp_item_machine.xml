<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exp_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#141A22"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:rippleColor="#2233D6C0"
    app:strokeColor="#22303C"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/exp_badge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#F2F6F8"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/exp_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F2F6F8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exp_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8A97A5"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/exp_running_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/exp_running_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exp_running"
                    android:textColor="#33D6C0"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exp_start"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="68dp"
                android:text="@string/exp_start"
                android:textColor="#0B0F14"
                android:textSize="13sp"
                app:backgroundTint="#33D6C0"
                app:cornerRadius="14dp"
                app:rippleColor="#33FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
