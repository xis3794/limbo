<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour tokens for the experimental (NPatch / Miuix style) UI only.

    Every value is copied verbatim from
    docs/team/npatch-miuix-style-spec.md section 1, which in turn is copied from
    miuix/.../theme/Colors.kt (lightColorScheme / darkColorScheme, Miuix 0.9.4).
    Do not tune these by feel: the spec is the single visual baseline.

    The light and the dark set live in the same file (no values-night copy) because
    the activity resolves them itself from Configuration.uiMode, as required.
-->
<resources>

    <!-- ===================== light (Miuix lightColorScheme) ===================== -->
    <color name="exp_light_primary">#3482FF</color>
    <color name="exp_light_on_primary">#FFFFFF</color>
    <color name="exp_light_background">#FFFFFF</color>
    <color name="exp_light_surface">#F7F7F7</color>
    <color name="exp_light_surface_container">#FFFFFF</color>
    <color name="exp_light_on_surface">#000000</color>
    <color name="exp_light_on_surface_secondary">#CC000000</color>
    <color name="exp_light_on_surface_variant_summary">#99000000</color>
    <color name="exp_light_on_surface_variant_actions">#66000000</color>
    <color name="exp_light_on_surface_container_variant">#959595</color>
    <color name="exp_light_outline">#D9D9D9</color>
    <color name="exp_light_divider_line">#E0E0E0</color>
    <color name="exp_light_secondary_container">#F0F0F0</color>
    <color name="exp_light_tertiary_container">#EAF2FF</color>
    <color name="exp_light_on_tertiary_container">#3482FF</color>
    <color name="exp_light_error">#E94634</color>
    <color name="exp_light_warning">#E65100</color>
    <!-- Translucent top bar background, shown only once the list is scrolled (spec 6.2). -->
    <color name="exp_light_top_bar_scrim">#F2FFFFFF</color>
    <!-- Floating capsule bar container (spec 6.3). It sits on the page background,
         which is #FFFFFF in light mode / #242424 in dark mode, so a 95% container
         renders identically to Miuix's solid surfaceContainer while still letting
         the page breathe through at the edges. -->
    <color name="exp_light_bottom_bar">#F2FFFFFF</color>

    <!-- ===================== dark (Miuix darkColorScheme) ===================== -->
    <color name="exp_dark_primary">#277AF7</color>
