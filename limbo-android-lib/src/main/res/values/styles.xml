<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Legacy base theme (kept for 3rd party dialogs) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="Transparent" parent="@android:style/Theme.Dialog"></style>

    <style name="leftEllipsisSpinnerDropDownItem" parent="@android:style/Widget.DropDownItem.Spinner">
        <item name="android:ellipsize">start</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="leftEllipsisSimpleSpinnerItem" parent="@android:style/Widget.TextView.SpinnerItem">
        <item name="android:ellipsize">start</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- ============================================================
         Limbo UI system  (light + dark, one restrained blue accent)
         ============================================================ -->

    <style name="LimboThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/limbo_accent</item>
        <item name="colorPrimaryDark">@color/limbo_bg</item>
        <item name="colorAccent">@color/limbo_accent</item>
        <item name="android:windowBackground">@color/limbo_bg</item>
        <item name="android:statusBarColor">@color/limbo_bg_top</item>
        <item name="android:navigationBarColor">@color/limbo_bg</item>
        <item name="android:textColorPrimary">@color/limbo_text</item>
        <item name="android:textColorSecondary">@color/limbo_text_dim</item>
        <item name="android:textColorHint">@color/limbo_text_muted</item>
        <item name="android:colorControlNormal">@color/limbo_text_dim</item>
        <item name="android:colorControlActivated">@color/limbo_accent</item>
        <item name="android:colorControlHighlight">@color/limbo_ripple</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="alertDialogTheme">@style/Limbo.Dialog</item>
        <item name="android:alertDialogTheme">@style/Limbo.DialogPlatform</item>
        <item name="android:popupMenuStyle">@style/LimboPopupMenu</item>
        <item name="actionOverflowButtonStyle">@style/LimboOverflowButton</item>
    </style>

    <style name="LimboMainTheme" parent="LimboThemeBase" />

    <style name="Limbo.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/limbo_accent</item>
        <item name="android:textColorPrimary">@color/limbo_text</item>
        <item name="android:textColorSecondary">@color/limbo_text_dim</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="Limbo.Dialog.Plain" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <style name="Limbo.DialogPlatform" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/limbo_accent</item>
        <item name="android:textColorPrimary">@color/limbo_text</item>
        <item name="android:textColorSecondary">@color/limbo_text_dim</item>
    </style>

    <style name="Limbo.PopupTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/limbo_text</item>
        <item name="android:colorBackground">@color/limbo_surface</item>
    </style>

    <style name="LimboPopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/limbo_surface</item>
        <item name="android:textColor">@color/limbo_text</item>
    </style>

    <style name="LimboOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/limbo_text</item>
    </style>

    <!-- Typography -->
    <style name="Limbo" />

    <style name="Limbo.Text" />

    <style name="Limbo.Text.BigTitle">
        <item name="android:textColor">@color/limbo_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.Text.PageTitle">
        <item name="android:textColor">@color/limbo_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.Text.Title">
        <item name="android:textColor">@color/limbo_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.Text.Section">
        <item name="android:textColor">@color/limbo_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.Text.CardTitle">
        <item name="android:textColor">@color/limbo_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.Text.Row">
        <item name="android:textColor">@color/limbo_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Limbo.Text.Value">
        <item name="android:textColor">@color/limbo_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.Text.Summary">
        <item name="android:textColor">@color/limbo_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Limbo.Text.SectionLabel">
        <item name="android:textColor">@color/limbo_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.ToolbarTitle">
        <item name="android:textColor">@color/limbo_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Surfaces -->
    <style name="Limbo.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Limbo.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:background">@drawable/bg_row</item>
    </style>

    <style name="Limbo.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/spinner_color</item>
    </style>

    <style name="Limbo.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/limbo_accent</item>
        <item name="android:textColorHint">@color/limbo_text_muted</item>
        <item name="android:background">@null</item>
        <item name="android:inputType">textFilter|textNoSuggestions</item>
    </style>

    <style name="Limbo.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:tint">@color/limbo_accent</item>
    </style>

    <style name="Limbo.IconChip">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/bg_icon_chip</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Limbo.NavLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Limbo.NavItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
